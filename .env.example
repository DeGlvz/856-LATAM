PORT=8080
ALCHEMY_API_KEY=
ALCHEMY_NETWORK=eth-sepolia
API_KEYS=clave-cliente-1
ALCHEMY_WEBHOOK_SIGNING_KEY=
DATABASE_URL=postgres://postgres:postgres@localhost:5432/cripto
DB_POOL_MAX=10
MIGRATE_ON_START=true
# Fase 3 — transferencias on-chain
SIGNER_PRIVATE_KEY=          # SOLO testnet: llave de la hot wallet (0x + 64 hex). Prohibida en mainnet
CONFIRMATIONS=3
WORKER_ENABLED=true
WORKER_INTERVAL_MS=10000
# RPC_URL=http://127.0.0.1:8545   # solo pruebas locales (sustituye Alchemy)
# Direcciones de depósito y barrido
# DEPOSIT_HD_SEED=0x…            # opcional; si falta se deriva de SIGNER_PRIVATE_KEY (solo testnet)
ALCHEMY_WEBHOOK_ID=wh_…          # webhook Address Activity
ALCHEMY_NOTIFY_TOKEN=            # Auth token de Webhooks (dashboard Alchemy → Webhooks)
SWEEP_ENABLED=true
SWEEP_MIN_NATIVE_WEI=1000000000000000
# Consola de operación (/console)
COOKIE_SECURE=true               # false solo en desarrollo local (http)
SESSION_TTL_MIN=480
SESSION_IDLE_MIN=30
CONSOLE_BOOTSTRAP_EMAIL=         # primer tesorero (solo si no hay operadores)
CONSOLE_BOOTSTRAP_PASSWORD=      # mín. 12 caracteres; BORRAR después del primer arranque
CONSOLE_INVITE_TTL_HOURS=72      # vigencia de invitaciones de operadores
GAS_LOW_WEI=50000000000000000    # alerta de gas en el tablero (0.05 ETH)
# Fase 5: doble aprobación y 2FA
DUAL_APPROVAL=console            # off | console (solo lo pedido desde la consola) | all (también API)
APPROVAL_REQUIRE_2FA=true        # el aprobador necesita 2FA y un código por aprobación
TOTP_ENCRYPTION_KEY=             # REQUERIDA para 2FA: openssl rand -hex 32 — no cambiarla después
TOTP_ISSUER=856-LATAM
# Gas bump: reemplazo de transacciones atascadas (mismo nonce, comisión más alta)
GAS_BUMP_ENABLED=true
GAS_BUMP_AFTER_SEC=300           # sin minarse tras este tiempo → se acelera
GAS_BUMP_PERCENT=25              # aumento por intento (mín. 11)
GAS_BUMP_MAX_FEE_WEI=300000000000  # tope de maxFeePerGas (300 gwei)
GAS_BUMP_MAX_ATTEMPTS=6
# Portal de clientes (/portal) — fase 1: identidad, usuarios y llaves
PORTAL_SESSION_TTL_MIN=480
PORTAL_SESSION_IDLE_MIN=30
PORTAL_INVITE_TTL_HOURS=72
PORTAL_KEY_MAX_DAYS=90           # vigencia máxima de una llave de API
PORTAL_KEY_OVERLAP_DAYS=7        # la llave anterior sigue viva estos días al rotar
PORTAL_SIG_WINDOW_SEC=300        # ventana de la marca de tiempo firmada
PORTAL_SIG_MAX_FAILS=10          # firmas inválidas antes de bloquear la llave 15 min
ORIGIN_RULE=off                  # off | enforce — con enforce solo el cliente origina salidas; la consola valida y autoriza
WHITELIST_COOLDOWN_HOURS=24      # espera tras aprobar una dirección de lista blanca
EXIT_SIMULATION_TTL_MIN=30       # vigencia de la simulación de una salida
EXIT_VALIDATION_SLA_MIN=240      # tiempo objetivo de validación de 856 (alerta en el tablero)
OBLIGATION_ACCEPT_TTL_HOURS=72   # plazo del deudor para aceptar o rechazar una obligación
OBLIGATION_IMPORT_MAX_ROWS=5000  # filas máximas por carga CSV de obligaciones
# Multi-red EVM (ola 1): la principal es ALCHEMY_NETWORK; NETWORKS agrega otras (csv)
NETWORKS=base-sepolia,arb-sepolia,polygon-amoy,bnb-testnet
DEFAULT_CLIENT_NETWORKS=eth-sepolia,base-sepolia,arb-sepolia,polygon-amoy,bnb-testnet  # activos que recibe cada cliente nuevo
# Por red: sufijo = id en mayúsculas con _ (BASE_SEPOLIA, ARB_SEPOLIA, POLYGON_AMOY, BNB_TESTNET)
ALCHEMY_WEBHOOK_ID_BASE_SEPOLIA=wh_…
ALCHEMY_WEBHOOK_SIGNING_KEY_BASE_SEPOLIA=
ALCHEMY_WEBHOOK_ID_ARB_SEPOLIA=wh_…
ALCHEMY_WEBHOOK_SIGNING_KEY_ARB_SEPOLIA=
ALCHEMY_WEBHOOK_ID_POLYGON_AMOY=
ALCHEMY_WEBHOOK_SIGNING_KEY_POLYGON_AMOY=
ALCHEMY_WEBHOOK_ID_BNB_TESTNET=wh_…
ALCHEMY_WEBHOOK_SIGNING_KEY_BNB_TESTNET=
# Opcionales por red (si faltan, se usan los generales):
# CONFIRMATIONS_BNB_TESTNET=6
# GAS_LOW_WEI_POLYGON_AMOY=1000000000000000000
# GAS_BUMP_MAX_FEE_WEI_POLYGON_AMOY=500000000000
# EXPLORER_URL_BASE_SEPOLIA=https://sepolia.basescan.org
# RPC_URL_BASE_SEPOLIA=http://127.0.0.1:8546   # solo pruebas locales
# ── Fase M1: dos despliegues del mismo código ──
# production: solo redes main (eth-mainnet, base-mainnet, arb-mainnet, bnb-mainnet); exige ORIGIN_RULE=enforce,
#             semilla HD propia (HD_MNEMONIC o DEPOSIT_HD_SEED) y un tesorero activo con 2FA.
# sandbox:    solo redes de prueba (eth-sepolia) para que los clientes prueben; distintivo «PRUEBAS» en consola y portal.
ENVIRONMENT=sandbox
# Semilla de las direcciones de depósito (una de las dos; en production obligatoria y DISTINTA a la del sandbox)
HD_MNEMONIC=
# DEPOSIT_HD_SEED=
# Mínimo para barrer una dirección de depósito, por activo, en unidades base (SWEEP_MIN_<ID DEL ACTIVO>, guiones → _).
# Debajo del mínimo el depósito se acredita igual; solo se espera a juntar más. Ejemplos de nombre (valores a definir):
# SWEEP_MIN_USDT_MAINNET=
# SWEEP_MIN_USDC_MAINNET=
# SWEEP_MIN_EURE_MAINNET=
# SWEEP_MIN_ETH_MAINNET=
# Webhooks de Alchemy por red main (production):
# ALCHEMY_WEBHOOK_ID_BASE_MAINNET=
# ALCHEMY_WEBHOOK_SIGNING_KEY_BASE_MAINNET=
# ALCHEMY_WEBHOOK_ID_ARB_MAINNET=
# ALCHEMY_WEBHOOK_SIGNING_KEY_ARB_MAINNET=
# ALCHEMY_WEBHOOK_ID_BNB_MAINNET=
# ALCHEMY_WEBHOOK_SIGNING_KEY_BNB_MAINNET=

# Ola 1b: activar solo las redes del ambiente elegido en NETWORKS.
# Webhooks por red (sin valores; configurar en el gestor de secretos):
ALCHEMY_WEBHOOK_ID_OPT_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_OPT_MAINNET=
ALCHEMY_WEBHOOK_ID_OPT_SEPOLIA=
ALCHEMY_WEBHOOK_SIGNING_KEY_OPT_SEPOLIA=
ALCHEMY_WEBHOOK_ID_POLYGON_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_POLYGON_MAINNET=
ALCHEMY_WEBHOOK_ID_AVAX_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_AVAX_MAINNET=
ALCHEMY_WEBHOOK_ID_AVAX_FUJI=
ALCHEMY_WEBHOOK_SIGNING_KEY_AVAX_FUJI=
ALCHEMY_WEBHOOK_ID_LINEA_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_LINEA_MAINNET=
ALCHEMY_WEBHOOK_ID_LINEA_SEPOLIA=
ALCHEMY_WEBHOOK_SIGNING_KEY_LINEA_SEPOLIA=
ALCHEMY_WEBHOOK_ID_CELO_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_CELO_MAINNET=
ALCHEMY_WEBHOOK_ID_CELO_SEPOLIA=
ALCHEMY_WEBHOOK_SIGNING_KEY_CELO_SEPOLIA=
ALCHEMY_WEBHOOK_ID_UNICHAIN_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_UNICHAIN_MAINNET=
ALCHEMY_WEBHOOK_ID_UNICHAIN_SEPOLIA=
ALCHEMY_WEBHOOK_SIGNING_KEY_UNICHAIN_SEPOLIA=
ALCHEMY_WEBHOOK_ID_WORLDCHAIN_MAINNET=
ALCHEMY_WEBHOOK_SIGNING_KEY_WORLDCHAIN_MAINNET=
ALCHEMY_WEBHOOK_ID_WORLDCHAIN_SEPOLIA=
ALCHEMY_WEBHOOK_SIGNING_KEY_WORLDCHAIN_SEPOLIA=
# Polygon Amoy: nombres ya declarados en la ola 1.
# Minimos de barrido por activo (unidades base):
SWEEP_MIN_ETH_OPT=
SWEEP_MIN_USDC_OPT=
SWEEP_MIN_POL_POLYGON=
SWEEP_MIN_USDC_POLYGON=
SWEEP_MIN_AVAX_AVAX=
SWEEP_MIN_USDC_AVAX=
SWEEP_MIN_USDT_AVAX=
SWEEP_MIN_ETH_LINEA=
SWEEP_MIN_USDC_LINEA=
SWEEP_MIN_CELO_CELO=
SWEEP_MIN_USDC_CELO=
SWEEP_MIN_USDT_CELO=
SWEEP_MIN_ETH_UNICHAIN=
SWEEP_MIN_USDC_UNICHAIN=
SWEEP_MIN_ETH_WORLDCHAIN=
SWEEP_MIN_USDC_WORLDCHAIN=
SWEEP_MIN_ETH_OPT_SEPOLIA=
SWEEP_MIN_USDC_OPT_SEPOLIA=
SWEEP_MIN_POL_AMOY=
SWEEP_MIN_USDC_AMOY=
SWEEP_MIN_AVAX_FUJI=
SWEEP_MIN_USDC_FUJI=
SWEEP_MIN_ETH_LINEA_SEPOLIA=
SWEEP_MIN_USDC_LINEA_SEPOLIA=
SWEEP_MIN_CELO_SEPOLIA=
SWEEP_MIN_USDC_CELO_SEPOLIA=
SWEEP_MIN_ETH_UNICHAIN_SEPOLIA=
SWEEP_MIN_USDC_UNICHAIN_SEPOLIA=
SWEEP_MIN_ETH_WORLDCHAIN_SEPOLIA=
SWEEP_MIN_USDC_WORLDCHAIN_SEPOLIA=

# ── Fase F1: entrada SEPA → EURe (Monerium; tesorería compartida o cuenta por cliente) ──
# Interruptor general: false = fiat real apagado. Activar solo en production tras aprobar el perfil de Monerium.
# En sandbox debe quedar en false: ahí se usa siempre el proveedor simulado, también con FIAT_MODE=per_client.
FIAT_LIVE_ENABLED=false
# production (api.monerium.app) | sandbox (api.monerium.dev; no se permite con ENVIRONMENT=production)
MONERIUM_ENV=production
# Credenciales de la app Private 856-LATAM-S2S (client credentials). Definir en el gestor de secretos; nunca en el repositorio.
MONERIUM_CLIENT_ID=
MONERIUM_CLIENT_SECRET=
# Secreto whsec_… requerido para aceptar webhooks firmados; sin él POST /v1/fiat/webhooks/monerium devuelve 503.
# Configurar el webhook del proveedor con esa URL; la aplicación verifica el cuerpo crudo y guarda el evento antes de confirmar.
MONERIUM_WEBHOOK_SECRET=
# treasury = IBAN/dirección compartidos; per_client = cuenta/dirección aislada por cliente.
# En producción, per_client exige FIAT_LIVE_ENABLED=true. Solo Monerium está soportado en producción.
# Circle aún no tiene API/adaptador implementado y responde provider_not_supported.
FIAT_MODE=treasury
# Red de la cuenta fiat: base → Base mainnet en production y Base Sepolia en sandbox.
# La red resuelta debe estar habilitada en NETWORKS para usar Monerium real.
FIAT_CHAIN=base
# Cada cuánto se sondean las órdenes del proveedor (ms, mínimo 5000)
FIAT_POLL_INTERVAL_MS=60000
# Vigencia de un aviso de pago (días)
FIAT_INTENT_TTL_DAYS=7
# Llave (≥32 caracteres) para cifrar con AES-256-GCM las cuentas bancarias de los rieles fiat: openssl rand -hex 32
# Sin ella no se pueden cargar ni mostrar cuentas (los rieles manuales no pueden encenderse). No cambiarla después.
FIAT_RAILS_ENC_KEY=

# ── Openfort (opcional): conciliación por webhook. Apagado por defecto; sin él todo opera como siempre ──
OPENFORT_ENABLED=false
# Claves del proyecto Openfort (definidas en Railway; nunca en el repositorio). Reservadas para llamadas a la API; hoy la integración solo recibe webhooks.
OPENFORT_PUBLISHABLE_KEY=
OPENFORT_SECRET_KEY=
# Secreto whsec_… de dashboard.openfort.io → Webhooks. Solo en el gestor de secretos; nunca en el repositorio.
OPENFORT_WEBHOOK_SECRET=

# -- AWS (Fase AWS1): llave de firma en KMS y secretos en SSM. Sin valores: viven en SSM Parameter Store --
# local = SIGNER_PRIVATE_KEY (solo sandbox y pruebas) | kms = AWS KMS (ECC_SECG_P256K1). En production con kms se rechaza SIGNER_PRIVATE_KEY.
SIGNER_BACKEND=
SIGNER_KMS_KEY_ID=
# Generacion de la semilla HD vigente (por defecto 1). Subirla al rotar HD_MNEMONIC: las anteriores no se barren ni se ligan.
HD_GENERATION=
# ssm = carga /856/production/* de SSM Parameter Store a process.env al arrancar (src/bootstrap.ts)
SECRETS_SOURCE=
SSM_PATH=
AWS_REGION=
